# Copier en .env et compléter (.env est ignoré par Git)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=immoinsight

# Assistant : clé Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Modèles essayés dans l'ordre (bascule sur le suivant si le quota du premier est atteint)
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# Limite par visiteur : nombre de questions par fenêtre (secondes)
CHAT_LIMITE_REQUETES=20
CHAT_FENETRE_S=600
